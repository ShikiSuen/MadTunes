{
  "sourceLanguage" : "en",
  "strings" : {
    "i18n.Tips.Tip4AudioOutputDeviceSelection.headerTitle" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio-Ausgabegerät festlegen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Specify Your Audio Output Device"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Especifique su dispositivo de salida de audio"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spécifiez votre périphérique de sortie audio"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Specifica il dispositivo di uscita audio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーディオ出力デバイスを指定"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오디오 출력 장치 지정"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Especifique seu dispositivo de saída de áudio"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Укажите устройство аудиовыхода"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses Çıkış Cihazınızı Belirleyin"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指定您的音频输出设备"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指定您的音訊輸出裝置"
          }
        }
      }
    },
    "i18n.Tips.Tip4AudioOutputDeviceSelection.msg" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können Ihr bevorzugtes Audio-Ausgabegerät auch auf einen virtuellen Audiotreiber wie SoundFlower einstellen, um Ihr Audio an Apple MainStage oder eine beliebige AudioUnit-/VST-Host-App weiterzuleiten und Ihre eigene DSP-Kette aufzubauen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You may also specify your preferred audio output device to any virtual audio driver like SoundFlower to route your audio to Apple MainStage or any AudioUnit / VST host app to build your own DSP chain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También puede especificar su dispositivo de salida de audio preferido a cualquier controlador de audio virtual como SoundFlower para enrutar su audio a Apple MainStage o cualquier aplicación host AudioUnit / VST y construir su propia cadena DSP."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez également spécifier votre périphérique de sortie audio préféré vers n'importe quel pilote audio virtuel comme SoundFlower pour acheminer votre audio vers Apple MainStage ou toute application hôte AudioUnit / VST afin de construire votre propre chaîne DSP."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi anche specificare il tuo dispositivo di uscita audio preferito su qualsiasi driver audio virtuale come SoundFlower per instradare l'audio verso Apple MainStage o qualsiasi app host AudioUnit / VST e costruire la tua catena DSP."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SoundFlower などの仮想オーディオドライバーにオーディオ出力デバイスを指定して、Apple MainStage や任意の AudioUnit / VST ホストアプリにオーディオをルーティングし、独自の DSP チェーンを構築することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SoundFlower와 같은 가상 오디오 드라이버를 오디오 출력 장치로 지정하여 Apple MainStage 또는 AudioUnit / VST 호스트 앱으로 오디오를 라우팅하고 자체 DSP 체인을 구축할 수도 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você também pode especificar seu dispositivo de saída de áudio preferido para qualquer driver de áudio virtual como o SoundFlower para rotear seu áudio para o Apple MainStage ou qualquer aplicativo host AudioUnit / VST e construir sua própria cadeia DSP."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы также можете указать предпочтительное устройство аудиовыхода на любой виртуальный аудиодрайвер, например SoundFlower, чтобы направить звук в Apple MainStage или любое приложение-хост AudioUnit / VST для построения собственной цепочки DSP."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayrıca tercih ettiğiniz ses çıkış cihazını SoundFlower gibi herhangi bir sanal ses sürücüsüne ayarlayarak sesinizi Apple MainStage veya herhangi bir AudioUnit / VST ana bilgisayar uygulamasına yönlendirebilir ve kendi DSP zincirinizi oluşturabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您也可以将偏好的音频输出设备指定为任何虚拟音频驱动（如 SoundFlower），以便将音频路由至 Apple MainStage 或其他 AudioUnit / VST 宿主应用程序，从而构建您自己的 DSP 处理链。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您還可以將首選音訊輸出裝置指定給任何虛擬音訊驅動程式（例如 SoundFlower），以便將音訊路由到 Apple MainStage 或任何 AudioUnit / VST 宿主應用，從而構築您自己的 DSP 處理鏈。"
          }
        }
      }
    },
    "i18n.Tips.Tip4ColumnBrowser.headerTitle" : {
