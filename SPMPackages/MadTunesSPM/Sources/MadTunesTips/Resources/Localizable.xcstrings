    "i18n.Tips.Tip4GridLayout.msg" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das standardmäßige horizontale Rasterlayout ist für Laptops oder Tablets konzipiert. Bei Verwendung eines Desktop-Monitors möchten Sie vielleicht andere Layouts ausprobieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The default horizontal grid is designed for laptops or tablets. You might want to try other layouts if using a desktop monitor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuadrícula horizontal predeterminada está diseñada para portátiles o tabletas. Es posible que desee probar otras disposiciones si utiliza un monitor de escritorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grille horizontale par défaut est conçue pour les ordinateurs portables ou les tablettes. Vous souhaiterez peut-être essayer d'autres dispositions si vous utilisez un écran de bureau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La griglia orizzontale predefinita è progettata per laptop o tablet. Potresti voler provare altri layout se utilizzi un monitor desktop."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトの横スクロールグリッドはノートパソコンやタブレット向けに設計されています。デスクトップモニターをお使いの場合は、他のレイアウトもお試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본 가로 그리드는 노트북이나 태블릿을 위해 설계되었습니다. 데스크탑 모니터를 사용하는 경우 다른 레이아웃을 시도해 보실 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A grade horizontal padrão é projetada para notebooks ou tablets. Talvez você queira experimentar outros layouts se estiver usando um monitor de mesa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Горизонтальная сетка по умолчанию предназначена для ноутбуков или планшетов. Если вы используете настольный монитор, возможно, стоит попробовать другие макеты."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsayılan yatay ızgara düzeni dizüstü bilgisayarlar veya tabletler için tasarlanmıştır. Masaüstü monitör kullanıyorsanız diğer düzenleri denemek isteyebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "预设的横向卷动格状布局是针对笔电与平板电脑设计的。如果您在使用桌上显示器的话，您或许会想切换到其他的布局。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設的橫向捲動格狀佈局是針對筆電與平板電腦設計的。如果您在使用桌上顯示器的話，您或許會想切換到其他的佈局。"
          }
        }
      }
    },
    "i18n.Tips.Tip4NonStaticPlaylists.headerTitle" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamische Playlists und Ordner-Playlists ausprobieren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try Dynamic Playlists and Folder Playlists"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pruebe las listas dinámicas y las listas de carpetas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essayez les playlists dynamiques et les playlists de dossiers"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova le playlist dinamiche e le playlist cartella"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダイナミックプレイリストとフォルダプレイリストをお試しください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동적 재생목록과 폴더 재생목록을 사용해 보세요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimente as playlists dinâmicas e as playlists de pastas"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попробуйте динамические плейлисты и плейлисты папок"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinamik Oynatma Listelerini ve Klasör Oynatma Listelerini Deneyin"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "试试动态播放清单与文件夹播放清单"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試試動態播放清單與資料夾播放清單"
          }
        }
      }
    },
    "i18n.Tips.Tip4NonStaticPlaylists.msg" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordner-Playlists aktualisieren ihren Inhalt automatisch beim Starten der App. Dynamische Playlists bestimmen ihren Inhalt durch anpassbare hierarchische Prädikate. Sie können auch eine oder mehrere Ordner-Playlists als Datenquelle einer dynamischen Playlist festlegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder playlists automatically update their contents when starting the app. Dynamic playlists have their contents determined by customizable hierarchical predicates. You may also specify one or more folder playlists as the data source of a dynamic playlist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las listas de carpetas actualizan automáticamente su contenido al iniciar la aplicación. Las listas dinámicas determinan su contenido mediante predicados jerárquicos personalizables. También puede especificar una o más listas de carpetas como fuente de datos de una lista dinámica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les playlists de dossiers mettent automatiquement à jour leur contenu au démarrage de l'application. Les playlists dynamiques déterminent leur contenu par des prédicats hiérarchiques personnalisables. Vous pouvez également spécifier une ou plusieurs playlists de dossiers comme source de données d'une playlist dynamique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le playlist cartella aggiornano automaticamente i loro contenuti all'avvio dell'app. Le playlist dinamiche hanno i loro contenuti determinati da predicati gerarchici personalizzabili. Puoi anche specificare una o più playlist cartella come origine dati di una playlist dinamica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダプレイリストはアプリ起動時に自動的に内容を更新します。ダイナミックプレイリストはカスタマイズ可能な階層述語によって内容が決定されます。1つ以上のフォルダプレイリストをダイナミックプレイリストのデータソースとして指定することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "폴더 재생목록은 앱 시작 시 자동으로 콘텐츠를 업데이트합니다. 동적 재생목록은 사용자 정의 가능한 계층적 술어에 의해 콘텐츠가 결정됩니다. 하나 이상의 폴더 재생목록을 동적 재생목록의 데이터 소스로 지정할 수도 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As playlists de pastas atualizam automaticamente seu conteúdo ao iniciar o aplicativo. As playlists dinâmicas têm seu conteúdo determinado por predicados hierárquicos personalizáveis. Você também pode especificar uma ou mais playlists de pastas como fonte de dados de uma playlist dinâmica."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плейлисты папок автоматически обновляют своё содержимое при запуске приложения. Содержимое динамических плейлистов определяется настраиваемыми иерархическими предикатами. Вы также можете указать один или несколько плейлистов папок в качестве источника данных для динамического плейлиста."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klasör oynatma listeleri, uygulama başlatıldığında içeriklerini otomatik olarak günceller. Dinamik oynatma listelerinin içerikleri özelleştirilebilir hiyerarşik koşullar tarafından belirlenir. Bir veya daha fazla klasör oynatma listesini dinamik bir oynatma listesinin veri kaynağı olarak da belirleyebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件夹播放清单会在软件每次运行时自动更新内容。动态播放清单允许自订层级谓词以决定其内容显示。您也可以将某个动态播放清单的数据源设定为一个或多个文件夹播放清单。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料夾播放清單會在軟體每次運行時自動更新內容。動態播放清單允許自訂層級述詞以決定其內容顯示。您也可以將某個動態播放清單的資料源設定為一個或多個資料夾播放清單。"
          }
        }
      }
