    "i18n.Tips.Tip4ColumnBrowser.msg" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Spalten-Browser in dieser App unterstützt die getrennte Filterung von Albumkünstlern und Titelkünstlern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Column Browser in this app supports filtering album artists separately from filtering track artists."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El navegador de columnas de esta aplicación permite filtrar artistas de álbum por separado de los artistas de pista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le navigateur de colonnes de cette application permet de filtrer les artistes d'album séparément des artistes de piste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il browser a colonne di questa app supporta il filtraggio degli artisti album separatamente dagli artisti brano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリのカラムブラウザは、アルバムアーティストとトラックアーティストを個別にフィルタリングできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱의 컬럼 브라우저는 앨범 아티스트와 트랙 아티스트를 별도로 필터링할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O navegador de colunas deste aplicativo permite filtrar artistas de álbum separadamente dos artistas de faixa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Браузер колонок в этом приложении поддерживает раздельную фильтрацию исполнителей альбомов и исполнителей треков."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu uygulamadaki sütun tarayıcısı, albüm sanatçılarını parça sanatçılarından ayrı olarak filtrelemeyi destekler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本软件的直栏筛选器可将专辑艺人与曲目艺人分开筛选。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "敝軟體的直欄篩選器可將專輯藝人與曲目藝人分開篩選。"
          }
        }
      }
    },
