    "i18n:Alert.RemoveAlbumsMessage:%lld" : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Dies entfernt %lld Album aus der Bibliothek. Die Originaldateien werden nicht gelöscht."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Dies entfernt %lld Alben aus der Bibliothek. Die Originaldateien werden nicht gelöscht."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This will remove %lld album from the library. The original files will not be deleted."
                }
              },
              "other" : {
                "stringUnit" : {
