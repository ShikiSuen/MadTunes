    "i18n:HotKeyHint.Record.GridView.DragSelectAlbums.Condition" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Nur wirksam, wenn kein Album erweitert ist) (Tippen Sie auf Gitterlücken, um die Gummibandauswahl zu starten)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "(Only effective when no album is expanded)\n(Tap the grid gaps to initiate the Rubber-band selection)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Solo efectivo cuando ningún álbum está expandido) (Toca los espacios de la cuadrícula para iniciar la selección por lazo)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Uniquement quand aucun album n'est étendu) (Touchez les espaces de la grille pour initier la sélection par lasso)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Solo quando nessun album è espanso) (Tocca gli spazi della griglia per avviare la selezione a laccio)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(アルバムが展開されていないときのみ有効)\n(グリッドのアイテム間の空き領域をタップしてラバーバンド選択を開始)"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(앨범이 확장되지 않았을 때만 효과적) (고무줄 선택을 시작하려면 그리드 간격을 탭하세요)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Somente efetivo quando nenhum álbum está expandido) (Toque nos espaços da grade para iniciar a seleção de laço)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Эффективно только когда ни один альбом не развернут) (Коснитесь пробелов сетки, чтобы начать выделение рамкой)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Yalnızca albüm genişletilmemişken etkili) (Kauçuk bant seçimini başlatmak için ızgara boşluklarına dokunun)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(仅在没有专辑展开时有效)\n(点击网格项目之间的空白区域以启动橡皮筋选择)"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(僅在沒有專輯展開時有效)\n(點擊網格項目之間的空白區域以啟動橡皮筋選取)"
          }
        }
      }
    },
