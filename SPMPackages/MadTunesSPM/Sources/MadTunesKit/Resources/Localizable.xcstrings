    "i18n:TrackInfo.FallbackNotice" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchgestrichene Felder wurden automatisch ausgefüllt, da die Original-Metadaten fehlen. Die tatsächliche Situation hängt von den Metadaten des Titels ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fields shown with strikethrough were automatically filled in because the original metadata is missing. The actual situation is subject to the track's own metadata."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los campos mostrados tachados se completaron automáticamente porque faltan los metadatos originales. La situación real depende de los metadatos de la pista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les champs affichés barrés ont été remplis automatiquement car les métadonnées originales sont manquantes. La situation réelle dépend des métadonnées de la piste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I campi mostrati barrati sono stati compilati automaticamente perché i metadati originali mancano. La situazione reale dipende dai metadati del brano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取り消し線で表示されている項目は、元のメタデータが欠落しているため自動的に補完されたものです。実際の情報は楽曲自体のメタデータに準じます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "취소선으로 표시된 필드는 원본 메타데이터가 누락되어 자동으로 채워졌습니다. 실제 상황은 트랙의 메타데이터에 따라 다릅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os campos exibidos com tachado foram preenchidos automaticamente porque os metadados originais estão ausentes. A situação real depende dos metadados da faixa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поля, отображаемые зачеркнутыми, были заполнены автоматически, так как исходные метаданные отсутствуют. Фактическая ситуация зависит от метаданных трека."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üstü çizili olarak gösterilen alanlar, orijinal meta veriler eksik olduğu için otomatik olarak dolduruldu. Gerçek durum parçanın kendi meta verilerine tabidir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以删除线标注的栏位为因原始中继资料缺失而自动填充的内容，实际情况以原始乐曲自身的中继资料为准。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以刪除線標注的欄位為因原始中繼資料缺失而自動填寫的內容，實際情況以原始樂曲自身的中繼資料為準。"
          }
        }
      }
    },
