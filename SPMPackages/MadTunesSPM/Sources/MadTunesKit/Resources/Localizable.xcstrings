        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将从媒体柜中移除 %lld 首曲目。原始文件不会被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將從媒體櫃中移除 %lld 首曲目。原始檔案不會被刪除。"
          }
