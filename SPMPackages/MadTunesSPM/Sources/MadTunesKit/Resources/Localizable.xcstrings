{
  "sourceLanguage" : "en",
  "strings" : {
    "i18n:Alert.RemoveAlbumsMessage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will remove %lld album(s) from the library. The original files will not be deleted."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブラリから%lldアルバムを削除します。元のファイルは削除されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将从媒体柜中移除 %lld 张专辑。原始文件不会被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將從媒體櫃中移除 %lld 張專輯。原始檔案不會被刪除。"
          }
        }
      }
    },
    "i18n:Alert.RemoveFromLibraryTitle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove from Library?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブラリから削除しますか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从媒体柜中移除？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從媒體櫃中移除？"
          }
        }
      }
    },
